{
  "name": "mesync-core",
  "version": "0.2.0",
  "description": "同频记忆引擎的内核：Markdown 判断链与五块心法，外加平台无关的运行时机制（存储、检索、常驻正文、工具语义）",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "bin/**/*.mjs",
    "templates/**/*.md",
    "docs/**/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./templates/*": "./templates/*",
    "./use.md": "./templates/mesync-use.md",
    "./chain-judge.md": "./templates/chain-judge.md",
    "./chain-rules.md": "./templates/chain-rules.md",
    "./meta/*.md": "./templates/meta/*.md",
    "./scenarios/*/scenario.md": "./templates/scenarios/*/scenario.md",
    "./scenarios/*/AGENT.md": "./templates/scenarios/*/AGENT.md",
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs && vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "memory",
    "agent",
    "methodology",
    "prompt",
    "markdown"
  ],
  "bin": {
    "mesync": "./bin/mesync.mjs"
  }
}
