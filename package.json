{
  "name": "mesync-core",
  "version": "0.1.0",
  "description": "同频记忆引擎的心法内核：纯 Markdown 的判断链与五块心法（无代码）",
  "license": "MIT",
  "files": [
    "templates/**/*.md",
    "docs/**/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./templates/*": "./templates/*",
    "./use.md": "./templates/mesync-use.md",
    "./chain-judge.md": "./templates/chain-judge.md",
    "./chain-rules.md": "./templates/chain-rules.md",
    "./meta/*.md": "./templates/meta/*.md",
    "./scenarios/*/scenario.md": "./templates/scenarios/*/scenario.md",
    "./scenarios/*/AGENT.md": "./templates/scenarios/*/AGENT.md",
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "memory",
    "agent",
    "methodology",
    "prompt",
    "markdown"
  ]
}